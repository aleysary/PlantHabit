rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Completions are immutable once written (duplicates rejected).
      match /completions/{id} {
        allow create: if request.auth.uid == uid
                      && !exists(/databases/$(database)/documents/users/$(uid)/completions/$(id));
        allow delete, read: if request.auth.uid == uid;
        allow update: if false;
      }

      // Badges can be created once and never changed.
      match /badges/{badgeId} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Username reservations: readable by anyone signed in, claimable once.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Outgoing email queue for the Trigger Email extension.
    match /mail/{id} {
      allow create: if request.auth != null && request.resource.data.from_uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
